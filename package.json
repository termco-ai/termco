    "@wterm/dom": "link:vendor/wterm/packages/@wterm/dom",
    "@wterm/ghostty": "link:vendor/wterm/packages/@wterm/ghostty",
    "ai": "^7.0.64",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "gpt-tokenizer": "^3.4.0",
    "node-pty": "^1.1.0-beta40",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
