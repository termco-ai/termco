{
  "name": "termco",
  "description": "A terminal-first, AI-native development workspace.",
  "author": "Termco AI",
  "private": true,
  "version": "0.9.6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/fix-native-perms.mjs",
    "bootstrap:wterm": "node scripts/bootstrap-wterm.mjs",
    "predev": "pnpm bootstrap:wterm",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:plugins": "node scripts/gen-plugin-authoring-catalog.mjs --check && node scripts/plugin-compiler.mjs --bundled",
    "build:plugins:all": "node scripts/gen-plugin-authoring-catalog.mjs --check && node scripts/plugin-compiler.mjs --all",
    "generate:plugin-authoring": "node scripts/gen-plugin-authoring-catalog.mjs",
    "prebuild": "pnpm bootstrap:wterm",
    "build": "pnpm build:plugins && pnpm build:renderer && pnpm build:electron",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "pretest": "pnpm bootstrap:wterm",
    "test": "vitest run --exclude \"plugin-repository/plugins/**\"",
    "test:plugins": "node scripts/run-plugin-tests.mjs",
    "test:ownership": "vitest run src/platform/productOwnership.test.ts src/platform/perPluginRemoval.test.ts src/platform/compiler.test.ts src/platform/sourceCatalog.test.ts",
    "test:profiles": "vitest run src/platform/composeProfile.test.ts src/platform/jsonSchema.test.ts src/platform/manifest.test.ts src/platform/profileTransactions.test.ts src/platform/resolve.test.ts src/platform/sourceCatalog.test.ts",
    "test:replacement": "vitest run src/platform/liveReplacement.test.ts src/platform/profileTransactions.test.ts src/platform/runtime.test.ts",
    "test:watch": "vitest",
    "replay:fixture": "node scripts/replay-fixture.mjs",
    "test:electron": "vitest run -c vitest.electron.config.ts",
    "test:windows-build-preflight": "vitest run src/platform/compiler.test.ts src/test/platformCommand.test.ts src/test/releaseWorkflow.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:only": "playwright test",
    "test:all": "pnpm test && pnpm test:plugins && pnpm test:electron",
    "verify:plugin-compatibility": "pnpm bootstrap:wterm && pnpm check-types:plugins && pnpm test:plugins && pnpm build:plugins:all",
    "verify:application-layout": "node scripts/verify-application-plugin-layout.mjs release",
    "verify:packaged": "pnpm dist && node scripts/verify-packaged.mjs",
    "verify:first-launch": "node scripts/verify-first-launch.mjs",
    "precheck-types": "pnpm bootstrap:wterm",
    "check-types": "tsc --noEmit",
    "check-types:plugins": "tsc -p tsconfig.plugins.json --noEmit",
    "lint": "biome lint ./src ./electron",
    "format": "biome format --write ./src ./electron"
  },
